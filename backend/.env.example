OCR_SPACE_API_KEY=

# Port to listen on. Most hosts (Hostinger included) assign their own -- leave unset in production
# and the platform's PORT env var will be picked up; defaults to 8080 for local dev.
PORT=

# Comma-separated list of origins allowed to call this API (the deployed frontend's URL, plus any
# Vercel preview-deployment URLs). Defaults to the local Vite dev server if unset.
ALLOWED_ORIGIN=

# Gemini reads a bank statement the normal parsers fail on, find no rows in, or leave at needs_review.
# Needs GEMINI_API_KEY and GEMINI_BILLING_CONFIRMED=true. Never used when the normal result is ok.
BANK_AI_FALLBACK=false
BANK_AI_MAX_PAGES=60
