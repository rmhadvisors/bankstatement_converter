{
  "name": "bankstatement-converter",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run build && npm run start --workspace backend",
    "lint": "npm run lint --workspace frontend",
    "format": "prettier --write .",
    "test": "npm run test --workspace backend",
    "test:ps1": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/test.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.7.3"
  }
}
